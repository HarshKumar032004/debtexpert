datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  passwordHash String
  role         String             @default("SUPPORT_AGENT") // SUPER_ADMIN | LEGAL_ADVISOR | SUPPORT_AGENT
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  leadsAssigned Lead[]            @relation("AssignedLeads")
  notes         LeadNote[]
  reminders     FollowUpReminder[]

  @@index([email])
  @@index([role])
}

model Lead {
  id                    String             @id @default(cuid())
  referenceId           String             @unique // e.g. DSE-XXXXXX
  fullName              String
  phone                 String             // Normalized E.164 91XXXXXXXXXX
  email                 String?
  city                  String?
  source                String             // HERO_QUICK_FORM, SERVICE_SIDEBAR, ELIGIBILITY_WIZARD, CONTACT_EVALUATION, CONSULTATION_BOOKING, CALCULATOR, WHATSAPP_INBOUND
  legalIssue            String             // Personal Loan, Credit Card, Recovery Harassment, Legal Notice / Sec 138, Multiple Loans
  lenders               String?            // JSON or comma-separated list of banks
  totalDebtRange        String?            // e.g. ₹3L–₹7L or numeric representation
  overdueStatus         String?            // Not Overdue, 1–3 Months, 3–6 Months, 6+ Months NPA
  harassmentLevel       String?            // Harassment Calls, Home Visits, Legal Notice Received, High EMI Burden, None
  settlementReadiness   String?            // Ready with funds, 3-6 months, Exploring options
  consultationMode      String?            // Phone Call, WhatsApp Video, Google Meet
  consultationSlot      String?            // Date & time slot
  preferredCallbackTime String?            // Morning 9–12, Afternoon 12–5, Anytime
  message               String?
  status                String             @default("NEW") // NEW, CONTACTED, FOLLOW_UP, CONSULTATION_SCHEDULED, CONVERTED, CLOSED
  assignedToId          String?
  assignedTo            User?              @relation("AssignedLeads", fields: [assignedToId], references: [id])
  nextFollowUpAt        DateTime?
  unreadCount           Int                @default(0)
  lastMessageAt         DateTime           @default(now())
  consentGiven          Boolean            @default(true)
  consentTimestamp      DateTime           @default(now())
  ipAddress             String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  notes                 LeadNote[]
  reminders             FollowUpReminder[]
  whatsAppMessages      WhatsAppMessage[]

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([source])
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  authorName String
  content    String
  createdAt  DateTime @default(now())

  @@index([leadId])
}

model FollowUpReminder {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?    @relation(fields: [assignedToId], references: [id])
  scheduledAt  DateTime
  note         String
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([leadId])
  @@index([scheduledAt])
}

model WhatsAppMessage {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  waMessageId  String?  @unique // Meta wamid.xxx
  direction    String   // INBOUND | OUTBOUND
  type         String   @default("text") // template | text | document | image
  content      String
  status       String   @default("SENT") // SENT | DELIVERED | READ | FAILED
  errorMessage String?
  sentById     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([leadId])
  @@index([direction])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String?
  userId    String?
  actorName String
  action    String   // LEAD_CREATED, LEAD_UPDATED, STATUS_UPDATED, NOTE_ADDED, REMINDER_SET, WHATSAPP_SENT
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}
